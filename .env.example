# Copy to .env and adjust as needed.

# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=5310
GATEWAY_JWT_SECRET=replace-with-32-bytes-of-random-base64

# Node URLs as seen from gateway / web UI
NODE_A_URL=http://127.0.0.1:5311
NODE_B_URL=http://127.0.0.1:5312
NODE_C_URL=http://127.0.0.1:5313

# When launching a node process these two are read
# (one of node_a / node_b / node_c)
NODE_ID=node_a
NODE_HOST=127.0.0.1
NODE_PORT=5311

# Quorum (2 of 3 by default for 1 fault tolerance)
QUORUM=2

# Toggle Flask debug
FLASK_DEBUG=0
